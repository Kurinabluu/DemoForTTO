# 开发/gh-pages：保留 DemoForTTO 前缀，API 走 /api/tto
VITE_USE_API=true
VITE_API_BASE_URL=/api
VITE_APP_BASE=/DemoForTTO/

# ============================================================
# [临时开发功能] 本地 JSON 兜底配置
# ============================================================
# 本地开发环境有数据库，不需要兜底功能
# 仅在生产环境（gh-pages）启用兜底，见 .env.production
# ============================================================
VITE_USE_LOCAL_JSON_FALLBACK=false
