# 生产环境（gh-pages）：默认走云后端 API
# 真实 Render 地址由 GitHub Actions 的 TTO_API_BASE_URL 变量注入，避免写死在 public 仓库
VITE_USE_API=true
VITE_API_BASE_URL=/api
VITE_APP_BASE=/DemoForTTO/
# 用于 canonical / sitemap / og:url。演示站可填 GitHub Pages origin；正式域名上线后改掉。不要对着演示站提交 Search Console。
VITE_SITE_ORIGIN=https://kurinabluu.github.io

# ============================================================
# [临时开发功能] 本地 data.json 兜底配置
# ============================================================
# 用途：gh-pages 临时切换到本地 data.json 兜底。
# 原来的备注先保留，方便后续恢复回云 API 模式。
# 
# 使用方法：
# - 设置为 true 启用本地 data.json 兜底功能
# - 设置为 false 或删除此行则使用正常 API 逻辑
#
# 启用后，gh-pages 直接使用 src/data/data.json，不发起 /api/tto/* 内容请求
# （isApiEnabled 在 PROD + 本开关为 true 时为 false）
# ============================================================
VITE_USE_LOCAL_JSON_FALLBACK=true
