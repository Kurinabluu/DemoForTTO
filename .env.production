# 生产环境：gh-pages 子路径部署，资源基路径保留 DemoForTTO 前缀
VITE_USE_API=true
VITE_API_BASE_URL=/api
VITE_APP_BASE=/DemoForTTO/

# ============================================================
# [临时开发功能] 本地 JSON 兜底配置
# ============================================================
# 用途：在开发阶段没有可用数据库时，使用本地 JSON 文件作为数据兜底
# 
# 使用方法：
# - 设置为 true 启用本地 JSON 兜底功能
# - 设置为 false 或删除此行则使用正常 API 逻辑
#
# 启用后，系统会在以下情况使用 src/data/fallback/ 目录下的 JSON 文件：
# 1. API 未启用（isApiEnabled = false）
# 2. API 调用失败
# 3. API 返回空数据
#
# 相关文件：
# - src/data/fallback/freeinfo_fallback.json
# - src/data/fallback/daytrip_fallback.json
#
# 删除计划：当后端数据库正式上线后，删除此功能和相关配置
# 删除步骤：见 src/utils/contentRepository.js 中的详细说明
# ============================================================
VITE_USE_LOCAL_JSON_FALLBACK=true
