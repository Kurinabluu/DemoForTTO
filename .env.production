# 生产环境（gh-pages）：连接云后端 API
# 真实 Render 地址由 GitHub Actions 的 TTO_API_BASE_URL 变量注入，避免写死在 public 仓库
VITE_USE_API=true
VITE_API_BASE_URL=/api
VITE_APP_BASE=/DemoForTTO/

# ============================================================
# [临时开发功能] 本地 JSON 兜底配置
# ============================================================
# 用途：旧版静态演示兜底。现在 gh-pages 已切换为云 API，默认关闭。
# 
# 使用方法：
# - 设置为 true 启用本地 JSON 兜底功能
# - 设置为 false 或删除此行则使用正常 API 逻辑
#
# 启用后，gh-pages 直接使用 src/data/fallback/ 下的 JSON，不发起 /api/tto/* 请求
# （isApiEnabled 在 PROD + 本开关为 true 时为 false）
#
# 相关文件：
# - src/data/fallback/freeinfo_fallback.json
# - src/data/fallback/daytrip_fallback.json
#
# 删除计划：当后端数据库正式上线后，删除此功能和相关配置
# 删除步骤：见 src/utils/contentRepository.js 中的详细说明
# ============================================================
VITE_USE_LOCAL_JSON_FALLBACK=false
